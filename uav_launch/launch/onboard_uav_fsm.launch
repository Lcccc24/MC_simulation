<launch>


    <!--include file="$(find nlink_parser)/launch/linktrack.launch" -->
    <!--/include -->
    
    <node pkg="planner" type="fake_uwb_node" name="fake_uwb_node" />
    
    <!-- 发布静态坐标系 map  world-->
    <node pkg="tf2_ros" type="static_transform_publisher" name="map_world_tf_pub" args="0 0 0 0 0 0 1 /map /world"/>

    <node pkg="planner" type="onboard_uav_node" name="onboard_uav_node" output="screen" />
        <param name="uav_id" type="int" value="1" />
        <param name="target_uav_id" type="int" value="0" />
        <param name="uav/origin_pos_offset_x" type="double" value="1.0" />
        <param name="uav/origin_pos_offset_y" type="double" value="0.0" />
        <param name="uav/origin_pos_offset_z" type="double" value="0.0" />
        <param name="uav/takeoff_height" type="double" value="1.0" />

        <param name="docking/return_pos_offset_x" type="double" value="1.5" />
        <param name="docking/return_pos_offset_y" type="double" value="2.0" />
        <param name="docking/return_pos_offset_z" type="double" value="2.5" /> <!-- 不能为零 -->
        <param name="docking/descend_hor_bias" type="double" value="0.4" />
        <param name="docking/descend_ver_bias" type="double" value="0.7" />
        <param name="docking/rec_hor_bias" type="double" value="0.2" />
        <param name="docking/rec_ver_bias" type="double" value="0.35" />
        <param name="docking/final_hor_bias" type="double" value="0.1" />
        <param name="docking/final_ver_bias" type="double" value="0.15" />
        <param name="docking/z_control_dead" type="double" value="0.0" />
        <param name="docking/allowed_retry_hover_time_s" type="double" value="3.0" />
        <param name="docking/retry_climb_height" type="double" value="2.0" />
        <param name="docking/allowed_retry_num" type="int" value="10" />

        <param name="mission/mission_pt1_x" type="double" value="3.0" />
        <param name="mission/mission_pt1_y" type="double" value="0.0" />
        <param name="mission/mission_pt1_z" type="double" value="4.0" />
        <param name="mission/mission_pt2_x" type="double" value="0.0" />
        <param name="mission/mission_pt2_y" type="double" value="10.0" />
        <param name="mission/mission_pt2_z" type="double" value="4.0" />
        <param name="mission/mission_pt3_x" type="double" value="3.0" />
        <param name="mission/mission_pt3_y" type="double" value="10.0" />
        <param name="mission/mission_pt3_z" type="double" value="4.0" />

        <param name="remote_guide/dock_r2m_x" type="double" value="0.0" />
        <param name="remote_guide/dock_r2m_y" type="double" value="0.0" />
        <param name="remote_guide/dock_r2m_z" type="double" value="1.4" />
        <param name="remote_guide/win_anchor_n" type="int" value="6" />
        <param name="remote_guide/search_flag" type="bool" value="true" />
        <param name="remote_guide/mean_cnt" type="int" value="20" />
        <param name="remote_guide/reach_target_thr" type="double" value="0.2" />
        <param name="remote_guide/settle_cnt" type="int" value="20" />
        <param name="remote_guide/exit_dist_thr" type="double" value="0.5" />
        <param name="remote_guide/exit_res_thr" type="double" value="0.25" />
        <param name="remote_guide/step_gamma" type="double" value="0.5" />
        <param name="remote_guide/step_min" type="double" value="0.3" />
        <param name="remote_guide/step_max" type="double" value="1.0" />
        <param name="remote_guide/res_gate_max" type="double" value="0.5" />
        <param name="remote_guide/res_gate_rms" type="double" value="0.25" />
        <!-- 上层 (z = +0.3) -->
        <param name="remote_guide/p_set_1_x" type="double" value=" 0.50" />
        <param name="remote_guide/p_set_1_y" type="double" value=" 0.00" />
        <param name="remote_guide/p_set_1_z" type="double" value=" 0.30" />
        <param name="remote_guide/p_set_2_x" type="double" value=" 0.25" />
        <param name="remote_guide/p_set_2_y" type="double" value=" 0.43" />
        <param name="remote_guide/p_set_2_z" type="double" value=" 0.30" />
        <!-- 中层 (z = 0.0) -->
        <param name="remote_guide/p_set_3_x" type="double" value="-0.25" />
        <param name="remote_guide/p_set_3_y" type="double" value=" 0.43" />
        <param name="remote_guide/p_set_3_z" type="double" value=" 0.00" />
        <param name="remote_guide/p_set_4_x" type="double" value="-0.50" />
        <param name="remote_guide/p_set_4_y" type="double" value=" 0.00" />
        <param name="remote_guide/p_set_4_z" type="double" value=" 0.00" />
        <!-- 下层 (z = -0.3) -->
        <param name="remote_guide/p_set_5_x" type="double" value="-0.25" />
        <param name="remote_guide/p_set_5_y" type="double" value="-0.43" />
        <param name="remote_guide/p_set_5_z" type="double" value="-0.30" />
        <param name="remote_guide/p_set_6_x" type="double" value=" 0.25" />
        <param name="remote_guide/p_set_6_y" type="double" value="-0.43" />
        <param name="remote_guide/p_set_6_z" type="double" value="-0.30" />
        <param name="remote_guide/go4_point_wait_count" type="int" value="60" />
        <param name="remote_guide/fly_away_test" type="bool" value="false" />
        
        <param name="msg_timeout/odom" type="double" value="0.5" />
        <param name="msg_timeout/onboard" type="double" value="0.5" />
        <param name="msg_timeout/landing_target" type="double" value="0.5" />
        <param name="trajectory/normal_minco_piece" type="int" value="10" />
        <param name="trajectory/landing_minco_piece" type="int" value="5" />

        <!-- TrajOpt -->
        <param name="traj_opt/is_landing" value="false"/>
        <param name="traj_opt/K" value="12"/>
        <param name="traj_opt/vmax" value="2.0"/>
        <param name="traj_opt/amax" value="5.0"/>
        <param name="traj_opt/jmax" value="20.0"/>
        <param name="traj_opt/omega_max" value="2.0"/>
        <param name="traj_opt/rhoT" value="2000.0"/>
        <param name="traj_opt/rhoP" value="60000.0"/>
        <param name="traj_opt/rhoV" value="10000.0"/>
        <param name="traj_opt/rhoA" value="1000.0"/>
        <param name="traj_opt/rhoJ" value="1000.0"/>
        <param name="traj_opt/rhoD" value="10000.0"/> 
        <param name="traj_opt/rhoC" value="50000.0"/> 
        <param name="traj_opt/rhoLV" value="80000.0"/>                                 
        <param name="traj_opt/rhoOmega" value="10000.0"/>
        <param name="traj_opt/LV_max" value="0.4"/>
        <param name="traj_opt/LV_min" value="0.15"/>
        <param name="traj_opt/emergency_stop_dist" value="1.5"/>
        <param name="traj_opt/safe_aera_radius" value="0.15"/>
        <param name="traj_opt/collision_avoid_radius" value="1.2"/>

    <node pkg="planner" type="traj_server_node" name="traj_server_node" output="screen" />

    <!-- 替母机发布指令 -->
    <!-- rosparam set /uav0_onboard/flight_command 1 -->
    <node pkg="uav_utils" type="uav0_onboard_msg" name="uav0_onboard_msg" output="screen" />
        <param name="/uav0_onboard/use_param_ctrl" type="bool" value="false" />
        <param name="/uav0_onboard/mission_pos_x" type="double" value="3.0" />
        <param name="/uav0_onboard/mission_pos_y" type="double" value="-3.0" />
        <param name="/uav0_onboard/mission_pos_z" type="double" value="6.0" />

    <!-- 可视化无人机 -->
    <node pkg="uav_utils" type="uav_pose_vis" name="uav_pose_vis" output="screen" >
        <remap from="/uav0/mavros/" to="/uav0/mavros/" />
        <remap from="/uav1/mavros/" to="/mavros/" />
        <remap from="/uav0/pose/visualization" to="/uav0/pose/visualization" />
        <remap from="/uav1/pose/visualization" to="/uav1/pose/visualization" />
    </node>
    <!-- RVIZ -->
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find uav_launch)/config/uav_vis.rviz" output="screen" /> -->

</launch>
